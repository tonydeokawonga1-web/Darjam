# DarJam production environment.
#
# Copy to .env for local production runs, or paste these into Render / your VPS.
# Never commit real secrets. Values marked OPTIONAL can be left unset.

# ---------------------------------------------------------------- server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Where reports are stored. Must be writable; mount it as a volume on a host.
DARJAM_REPORTS_FILE=/app/data/reports.json

# Origins allowed to call /api/* cross-origin (the Android WebView uses
# https://localhost because the app is loaded with the https scheme).
DARJAM_ALLOWED_ORIGINS=capacitor://localhost,https://localhost

# Public URL shown when the user taps Share in the app (optional).
# DARJAM_WEBSITE=https://<your-host>

# Dev only: freeze the model clock (ISO or epoch ms) for screenshots and tests.
# Never set this in production.
# DARJAM_NOW=2026-10-21T14:45:00Z

# ---------------------------------------------------------------- map tiles
# REQUIRED for a commercial release. Example for MapTiler's dark raster style.
# DARJAM_TILE_URL=https://api.maptiler.com/maps/dataviz-dark/{z}/{x}/{y}.jpg?key=YOUR_KEY
DARJAM_TILE_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
DARJAM_TILE_MAX_ZOOM=20
# Optional second layer for labels. Leave unset: setting DARJAM_TILE_URL already
# disables the default Esri reference layer.
# DARJAM_TILE_LABELS_URL=

# ---------------------------------------------------------------- weather
# Open-Meteo's free tier is non-commercial. Either set a paid API key, or set
# DARJAM_WEATHER=off to run without live rain.
# OPEN_METEO_API_KEY=
# DARJAM_WEATHER=on

# ------------------------------------------------- Android build (npm run build:mobile)
# DARJAM_API_BASE=https://<your-host>
# DARJAM_ADMOB_TEST=0
# DARJAM_ADMOB_BANNER=ca-app-pub-.../...
# DARJAM_ADMOB_INTERSTITIAL=ca-app-pub-.../...
# DARJAM_VERSION_NAME=1.0.0

# ------------------------------------------------- release signing (never commit values)
# DARJAM_KEYSTORE=/absolute/path/darjam-upload.jks
# DARJAM_KEYSTORE_PASSWORD=
# DARJAM_KEY_ALIAS=darjam
# DARJAM_KEY_PASSWORD=
# DARJAM_VERSION_CODE=1
